<?xml version="1.0" encoding="utf-8"?>
<items>
    <enumtypes>
        <enumtype code="OrderStatus">
            <value code="NEW"/>
            <value code="PROCESSING"/>
            <value code="SHIPPED"/>
            <value code="CANCELLED"/>
        </enumtype>
        <enumtype code="ProductType">
            <value code="PHYSICAL"/>
            <value code="DIGITAL"/>
        </enumtype>
    </enumtypes>

    <itemtypes>
        <itemtype code="Customer">
            <attributes>
                <attribute qualifier="uid" type="java.lang.String">
                    <modifiers unique="true" optional="false"/>
                </attribute>
                <attribute qualifier="name" type="java.lang.String"/>
                <attribute qualifier="email" type="java.lang.String"/>
            </attributes>
        </itemtype>

        <itemtype code="Product">
            <attributes>
                <attribute qualifier="code" type="java.lang.String">
                    <modifiers unique="true" optional="false"/>
                </attribute>
                <attribute qualifier="name" type="java.lang.String"/>
                <attribute qualifier="price" type="java.math.BigDecimal"/>
                <attribute qualifier="type" type="ProductType">
                    <defaultvalue>PHYSICAL</defaultvalue>
                </attribute>
                <attribute qualifier="stockLevel" type="java.lang.Integer"/>
            </attributes>
        </itemtype>

        <itemtype code="Order">
            <attributes>
                <attribute qualifier="code" type="java.lang.String">
                    <modifiers unique="true" optional="false"/>
                </attribute>
                <attribute qualifier="totalAmount" type="java.math.BigDecimal"/>
                <attribute qualifier="status" type="OrderStatus">
                    <defaultvalue>NEW</defaultvalue>
                </attribute>
                <!-- 'priority' is used by the Java source but NOT declared here,
                     so schema reconciliation should auto-add Priority__c. -->
            </attributes>
        </itemtype>
    </itemtypes>

    <relations>
        <relation code="Customer2Orders">
            <sourceElement type="Customer" cardinality="one"/>
            <targetElement type="Order" cardinality="many"/>
        </relation>
    </relations>
</items>
