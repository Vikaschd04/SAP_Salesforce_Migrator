<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_order_place_after">
        <observer name="acme_loyalty_award_points"
                  instance="Acme\Loyalty\Observer\AwardPointsObserver"/>
    </event>
    <event name="checkout_cart_product_add_after">
        <observer name="acme_loyalty_tier_check"
                  instance="Acme\Loyalty\Observer\TierCheckObserver"/>
    </event>
</config>
