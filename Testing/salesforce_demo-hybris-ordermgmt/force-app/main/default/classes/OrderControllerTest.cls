{"code":"@isTest\nprivate class OrderControllerTest {\n\n    @testSetup\n    static void setup() {\n        List<Order__c> orders = new List<Order__c>();\n        orders.add(new Order__c(Code__c = 'ORD-1', Status__c = 'NEW', TotalAmount__c = 750, Paid__c = true));\n        orders.add(new Order__c(Code__c = 'ORD-2', Status__c = 'NEW', TotalAmount__c = 100, Paid__c = false));\n        orders.add(new Order__c(Code__c = 'ORD-3', Status__c = 'SHIPPED', TotalAmount__c = 900, Paid__c = true));\n        insert orders;\n    }\n\n    private static RestRequest buildRequest(String uri, String method) {\n        RestRequest req = new RestRequest();\n        req.requestURI = uri;\n        req.httpMethod = method;\n        RestContext.request = req;\n        RestContext.response = new RestResponse();\n        return req;\n    }\n\n    @isTest\n    static void testGetSingleOrder() {\n        buildRequest('/orders/ORD-1', 'GET');\n        Test.startTest();\n        OrderController.OrderSummary summary = OrderController.doGet();\n        Test.stopTest();\n        System.assertNotEquals(null, summary, 'Summary should be returned');\n        System.assertEquals('ORD-1', summary.code, 'Code should match');\n        System.assertEquals('NEW', summary.status, 'Status should match');\n        System.assertEquals(true, summary.expedited, 'Paid high-value order is expedited');\n    }\n\n    @isTest\n    static void testGetOrdersByStatus() {\n        buildRequest('/orders/status/new', 'GET');\n        Test.startTest();\n        OrderController.doGet();\n        Test.stopTest();\n        String body = RestContext.response.responseBody.toString();\n        System.assert(body.contains('ORD-1'), 'Response should contain ORD-1');\n        System.assert(body.contains('ORD-2'), 'Response should contain ORD-2');\n        System.assert(!body.contains('ORD-3'), 'Shipped order should not be in NEW list');\n    }\n\n    @isTest\n    static void testCancelUnshippedOrder() {\n        buildRequest('/orders/ORD-1/cancel', 'POST');\n        Test.startTest();\n        OrderController.doPost();\n        Test.stopTest();\n        System.assertEquals(204, RestContext.response.statusCode, 'Should return 204 NO_CONTENT');\n        Order__c updated = [SELECT Status__c FROM Order__c WHERE Code__c = 'ORD-1' LIMIT 1];\n        System.assertEquals('CANCELLED', updated.Status__c, 'Order should be cancelled');\n    }\n\n    @isTest\n    static void testCancelShippedOrderFails() {\n        buildRequest('/orders/ORD-3/cancel', 'POST');\n        Boolean threw = false;\n        Test.startTest();\n        try {\n            OrderController.doPost();\n        } catch (Exception e) {\n            threw = true;\n        }\n        Test.stopTest();\n        System.assertEquals(true, threw, 'Cancelling a shipped order should throw');\n    }\n\n    @isTest\n    static void testGetMissingOrderReturnsNull() {\n        buildRequest('/orders/NOPE', 'GET');\n        Test.startTest();\n        OrderController.OrderSummary summary = OrderController.doGet();\n        Test.stopTest();\n        System.assertEquals(null, summary, 'Unknown order returns null summary');\n    }\n\n    // ---------------------------------------------------------------------\n    // Rule: Status string is parsed case-insensitively via\n    //       OrderStatus.valueOf(status.toUpperCase())\n    // ---------------------------------------------------------------------\n\n    @isTest\n    static void testStatusParsedCaseInsensitively_MixedCase() {\n        // Records seeded with Status__c = 'NEW'. Querying with mixed/lower case\n        // must still resolve because the service upper-cases before matching.\n        buildRequest('/orders/status/NeW', 'GET');\n        Test.startTest();\n        OrderController.OrderSummary result = OrderController.doGet();\n        Test.stopTest();\n\n        System.assertEquals(null, result, 'List path returns null and writes the body directly');\n        String body = RestContext.response.responseBody.toString();\n        System.assert(body.contains('ORD-1'), 'Mixed-case status should resolve to NEW orders');\n        System.assert(body.contains('ORD-2'), 'Mixed-case status should resolve to NEW orders');\n        System.assert(!body.contains('ORD-3'), 'SHIPPED orders excluded from NEW query');\n    }\n\n    @isTest\n    static void testStatusParsedCaseInsensitively_UpperCaseEquivalence() {\n        // Prove that lower-case and upper-case queries return identical results,\n        // demonstrating the toUpperCase() normalization in the service layer.\n        buildRequest('/orders/status/new', 'GET');\n        Test.startTest();\n        OrderController.doGet();\n        String lowerBody = RestContext.response.responseBody.toString();\n\n        buildRequest('/orders/status/NEW', 'GET');\n        OrderController.doGet();\n        String upperBody = RestContext.response.responseBody.toString();\n        Test.stopTest();\n\n        List<OrderController.OrderSummary> lowerList =\n            (List<OrderController.OrderSummary>) JSON.deserialize(lowerBody, List<OrderController.OrderSummary>.class);\n        List<OrderController.OrderSummary> upperList =\n            (List<OrderController.OrderSummary>) JSON.deserialize(upperBody, List<OrderController.OrderSummary>.class);\n\n        System.assertEquals(upperList.size(), lowerList.size(),\n            'Case-insensitive parsing must yield the same number of orders regardless of input case');\n        System.assertEquals(2, lowerList.size(), 'Exactly two NEW orders exist');\n    }\n\n    // ---------------------------------------------------------------------\n    // Rule: Expedited flag on summary is determined by orderService.isExpedited\n    //       (paid AND totalAmount >= 500)\n    // ---------------------------------------------------------------------\n\n    @isTest\n    static void testExpeditedFlag_PaidHighValueIsExpedited() {\n        // ORD-1: Paid = true, TotalAmount = 750 -> expedited\n        buildRequest('/orders/ORD-1', 'GET');\n        Test.startTest();\n        OrderController.OrderSummary summary = OrderController.doGet();\n        Test.stopTest();\n        System.assertNotEquals(null, summary, 'Summary should be returned');\n        System.assertEquals(true, summary.expedited,\n            'Paid high-value order must be flagged expedited by the service');\n    }\n\n    @isTest\n    static void testExpeditedFlag_UnpaidLowValueNotExpedited() {\n        // ORD-2: Paid = false, TotalAmount = 100 -> NOT expedited\n        buildRequest('/orders/ORD-2', 'GET');\n        Test.startTest();\n        OrderController.OrderSummary summary = OrderController.doGet();\n        Test.stopTest();\n        System.assertNotEquals(null, summary, 'Summary should be returned');\n        System.assertEquals(false, summary.expedited,\n            'Unpaid low-value order must not be flagged expedited');\n    }\n\n    @isTest\n    static void testExpeditedFlag_PaidButLowValueNotExpedited() {\n        // High value alone is insufficient; must be paid AND >= 500.\n        Order__c o = new Order__c(Code__c = 'ORD-PAID-LOW', Status__c = 'NEW', TotalAmount__c = 200, Paid__c = true);\n        insert o;\n        buildRequest('/orders/ORD-PAID-LOW', 'GET');\n        Test.startTest();\n        OrderController.OrderSummary summary = OrderController.doGet();\n        Test.stopTest();\n        System.assertNotEquals(null, summary, 'Summary should be returned');\n        System.assertEquals(false, summary.expedited,\n            'Paid but low-value order must not be expedited (needs total >= 500)');\n    }\n\n    @isTest\n    static void testExpeditedFlag_HighValueButUnpaidNotExpedited() {\n        // Paid flag is required; high value alone is not enough.\n        Order__c o = new Order__c(Code__c = 'ORD-HIGH-UNPAID', Status__c = 'NEW', TotalAmount__c = 999, Paid__c = false);\n        insert o;\n        buildRequest('/orders/ORD-HIGH-UNPAID', 'GET');\n        Test.startTest();\n        OrderController.OrderSummary summary = OrderController.doGet();\n        Test.stopTest();\n        System.assertNotEquals(null, summary, 'Summary should be returned');\n        System.assertEquals(false, summary.expedited,\n            'High-value but unpaid order must not be expedited (needs Paid__c = true)');\n    }\n\n    @isTest\n    static void testExpeditedFlag_BoundaryExactly500IsExpedited() {\n        // Boundary: totalAmount == 500 with paid == true is expedited (>= 500).\n        Order__c o = new Order__c(Code__c = 'ORD-BOUNDARY', Status__c = 'NEW', TotalAmount__c = 500, Paid__c = true);\n        insert o;\n        buildRequest('/orders/ORD-BOUNDARY', 'GET');\n        Test.startTest();\n        OrderController.OrderSummary summary = OrderController.doGet();\n        Test.stopTest();\n        System.assertNotEquals(null, summary, 'Summary should be returned');\n        System.assertEquals(true, summary.expedited,\n            'Order at the exact 500 threshold and paid must be expedited');\n    }\n\n    // ---------------------------------------------------------------------\n    // Rule: Order cancellation restricted to orders not yet shipped\n    //       (enforced in the service, surfaced to the controller)\n    // ---------------------------------------------------------------------\n\n    @isTest\n    static void testCancelRestrictedToNotShipped_ShippedRejected() {\n        // ORD-3 is SHIPPED -> cancellation must be rejected with an exception\n        // and the order status must remain unchanged.\n        buildRequest('/orders/ORD-3/cancel', 'POST');\n        Boolean threw = false;\n        String message;\n        Test.startTest();\n        try {\n            OrderController.doPost();\n        } catch (OrderController.OrderControllerException e) {\n            threw = true;\n            message = e.getMessage();\n        }\n        Test.stopTest();\n\n        System.assertEquals(true, threw, 'Cancelling a shipped order must throw an OrderControllerException');\n        System.assert(message != null && message.contains('shipped'),\n            'Error message should explain the shipped-order restriction: ' + message);\n        Order__c unchanged = [SELECT Status__c FROM Order__c WHERE Code__c = 'ORD-3' LIMIT 1];\n        System.assertEquals('SHIPPED', unchanged.Status__c,\n            'A shipped order must not be modified when cancellation is rejected');\n    }\n\n    @isTest\n    static void testCancelRestrictedToNotShipped_UnshippedAllowed() {\n        // Positive counterpart: a not-yet-shipped order (ORD-2, NEW) cancels fine.\n        buildRequest('/orders/ORD-2/cancel', 'POST');\n        Test.startTest();\n        OrderController.doPost();\n        Test.stopTest();\n\n        System.assertEquals(204, RestContext.response.statusCode, 'Unshipped order cancellation returns 204');\n        Order__c updated = [SELECT Status__c FROM Order__c WHERE Code__c = 'ORD-2' LIMIT 1];\n        System.assertEquals('CANCELLED', updated.Status__c, 'Not-yet-shipped order should be cancelled');\n    }\n\n    // ---------------------------------------------------------------------\n    // Rule: No business rules reside in the controller; logic is delegated\n    //       to the order service. These tests exercise the controller end to\n    //       end and System.assert(it forwards inputs and returns service output.\n    // ---------------------------------------------------------------------\n\n    @isTest\n    static void testControllerDelegatesGetToService() {\n        buildRequest('/orders/ORD-1', 'GET'));\n        Test.startTest();\n        OrderController.OrderSummary summary = OrderController.doGet();\n        Test.stopTest();\n\n        System.assertNotEquals(null, summary, 'Controller should return the service-produced summary');\n        System.assertEquals('ORD-1', summary.code,\n            'Controller returns exactly what the service provides (no controller-side computation)');\n        System.assertEquals(true, summary.expedited,\n            'Expedited value comes straight from the service, not the controller');\n    }\n\n    @isTest\n    static void testControllerDelegatesStatusToService() {\n        buildRequest('/orders/status/new', 'GET');\n        Test.startTest();\n        OrderController.doGet();\n        Test.stopTest();\n\n        String body = RestContext.response.responseBody.toString();\n        System.assert(body.contains('ORD-1'),\n            'Controller forwards the status token to the service; parsing/normalization lives in the service');\n    }\n\n    @isTest\n    static void testControllerDelegatesCancelToService() {\n        buildRequest('/orders/ORD-1/cancel', 'POST');\n        Test.startTest();\n        OrderController.doPost();\n        Test.stopTest();\n\n        System.assertEquals(204, RestContext.response.statusCode, 'Controller returns 204 after delegating cancel');\n        Order__c updated = [SELECT Status__c FROM Order__c WHERE Code__c = 'ORD-1' LIMIT 1];\n        System.assertEquals('CANCELLED', updated.Status__c,\n            'Controller must forward the code to the service without applying its own cancel rules');\n    }\n\n    @isTest\n    static void testControllerTranslatesServiceExceptionOnly() {\n        // The controller owns no cancel rule; it merely translates a service\n        // exception into its own type. Assert that translation happens.\n        buildRequest('/orders/ORD-3/cancel', 'POST');\n        Boolean threw = false;\n        Test.startTest();\n        try {\n            OrderController.doPost();\n        } catch (OrderController.OrderControllerException e) {\n            threw = true;\n        }\n        Test.stopTest();\n\n        System.assertEquals(true, threw, 'Controller should surface the service error as OrderControllerException');\n    }\n\n    @isTest\n    static void testCancelBlankCodeRejected() {\n        // Controller-level input guard: blank code must be rejected before delegation.\n        Boolean threw = false;\n        Test.startTest();\n        try {\n            OrderController.cancelOrders(new Set<String>{ '   ' });\n        } catch (OrderController.OrderControllerException e) {\n            threw = true;\n        }\n        Test.stopTest();\n        System.assertEquals(true, threw, 'Blank order code must throw an OrderControllerException');\n    }\n\n    @isTest\n    static void testUnsupportedGetPathThrows() {\n        buildRequest('/orders/a/b/c', 'GET');\n        Boolean threw = false;\n        Test.startTest();\n        try {\n            OrderController.doGet();\n        } catch (OrderController.OrderControllerException e) {\n            threw = true;\n        }\n        Test.stopTest();\n        System.assertEquals(true, threw, 'Unsupported GET path should throw');\n    }\n\n    @isTest\n    static void testUnsupportedPostPathThrows() {\n        buildRequest('/orders/ORD-1/notcancel', 'POST');\n