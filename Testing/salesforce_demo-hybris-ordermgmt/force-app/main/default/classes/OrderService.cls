{"code":"/**\n * Custom exception thrown when a referenced model (Product, Customer, etc.)\n * cannot be located. Replaces the Hybris/Spring ModelNotFoundException.\n */\npublic class ModelNotFoundException extends Exception {}\n\n/**\n * Custom exception used for order business-rule validation failures.\n * Replaces Java IllegalArgumentException / IllegalStateException usage.\n */\npublic class OrderValidationException extends Exception {}\n\n/**\n * Selector layer for Product__c. Owns all Product SOQL.\n */\npublic with sharing class ProductSelector {\n    public List<Product__c> selectByCodes(Set<String> codes) {\n        if (codes == null || codes.isEmpty()) {\n            return new List<Product__c>();\n        }\n        return [\n            SELECT Id, Code__c, Name__c, Active__c, StockLevel__c, Price__c, ProductType__c\n            FROM Product__c\n            WHERE Code__c IN :codes\n            WITH SECURITY_ENFORCED\n        ];\n    }\n}\n\n/**\n * Selector layer for Customer__c. Owns all Customer SOQL.\n */\npublic with sharing class CustomerSelector {\n    public List<Customer__c> selectByUids(Set<String> uids) {\n        if (uids == null || uids.isEmpty()) {\n            return new List<Customer__c>();\n        }\n        return [\n            SELECT Id, Uid__c, Name__c, Email__c, LoyaltyTier__c\n            FROM Customer__c\n            WHERE Uid__c IN :uids\n            WITH SECURITY_ENFORCED\n        ];\n    }\n}\n\n/**\n * Selector layer for Order__c. Owns all Order SOQL.\n */\npublic with sharing class OrderSelector {\n    public List<Order__c> selectByCodes(Set<String> codes) {\n        if (codes == null || codes.isEmpty()) {\n            return new List<Order__c>();\n        }\n        return [\n            SELECT Id, Code__c, Status__c, Paid__c, OrderDate__c, TotalAmount__c, Customer__c\n            FROM Order__c\n            WHERE Code__c IN :codes\n            WITH SECURITY_ENFORCED\n        ];\n    }\n}\n\n/**\n * Stateless, bulkified service that migrates the original single-record\n * Hybris order creation logic. Uses constructor injection for its selectors\n * (translated from Spring @Autowired).\n */\npublic with sharing class OrderService {\n\n    // Orders whose total exceeds this threshold are flagged as expedited.\n    public static final Decimal EXPEDITED_THRESHOLD = 1000;\n\n    private final ProductSelector productSelector;\n    private final CustomerSelector customerSelector;\n\n    /** Default constructor wires up the concrete selectors. */\n    public OrderService() {\n        this(new ProductSelector(), new CustomerSelector());\n    }\n\n    /** Constructor injection (replaces Spring @Autowired). */\n    public OrderService(ProductSelector productSelector, CustomerSelector customerSelector) {\n        this.productSelector = productSelector;\n        this.customerSelector = customerSelector;\n    }\n\n    /**\n     * Simple DTO representing a single line to add to an order.\n     */\n    public class OrderLine {\n        public String productCode;\n        public Decimal quantity;\n\n        public OrderLine(String productCode, Decimal quantity) {\n            this.productCode = productCode;\n            this.quantity = quantity;\n        }\n    }\n\n    /**\n     * DTO representing a request to create a single order.\n     */\n    public class OrderRequest {\n        public String code;\n        public String customerUid;\n        public List<OrderLine> lines;\n\n        public OrderRequest(String code, String customerUid, List<OrderLine> lines) {\n            this.code = code;\n            this.customerUid = customerUid;\n            this.lines = lines;\n        }\n    }\n\n    /**\n     * Bulk-safe order creation. The original Hybris method processed a single\n     * order; this version accepts and returns collections.\n     */\n    public List<Order__c> createOrders(List<OrderRequest> requests) {\n        List<Order__c> createdOrders = new List<Order__c>();\n        if (requests == null || requests.isEmpty()) {\n            return createdOrders;\n        }\n\n        // Gather all codes / uids for bulk lookups (no SOQL in loops).\n        Set<String> productCodes = new Set<String>();\n        Set<String> customerUids = new Set<String>();\n\n        for (OrderRequest req : requests) {\n            // Blank-code validation.\n            if (String.isBlank(req.code)) {\n                throw new OrderValidationException('Order code must not be blank.');\n            }\n            if (String.isBlank(req.customerUid)) {\n                throw new OrderValidationException('Customer must be provided.');\n            }\n            // Entry validation.\n            if (req.lines == null || req.lines.isEmpty()) {\n                throw new OrderValidationException('Order ' + req.code + ' must contain at least one entry.');\n            }\n            customerUids.add(req.customerUid);\n            for (OrderLine line : req.lines) {\n                if (String.isBlank(line.productCode)) {\n                    throw new OrderValidationException('Order entry product code must not be blank.');\n                }\n                // Strictly positive quantity check.\n                if (line.quantity == null || line.quantity <= 0) {\n                    throw new OrderValidationException('Order entry quantity must be strictly positive.');\n                }\n                productCodes.add(line.productCode);\n            }\n        }\n\n        // Bulk selector calls.\n        Map<String, Product__c> productsByCode = new Map<String, Product__c>();\n        for (Product__c p : productSelector.selectByCodes(productCodes)) {\n            productsByCode.put(p.Code__c, p);\n        }\n\n        Map<String, Customer__c> customersByUid = new Map<String, Customer__c>();\n        for (Customer__c c : customerSelector.selectByUids(customerUids)) {\n            customersByUid.put(c.Uid__c, c);\n        }\n\n        List<Order__c> ordersToInsert = new List<Order__c>();\n        List<OrderEntry__c> entriesToInsert = new List<OrderEntry__c>();\n        // Track entries per order index so we can wire lookups after insert.\n        Map<Integer, List<OrderEntry__c>> entriesByOrderIndex = new Map<Integer, List<OrderEntry__c>>();\n\n        Integer index = 0;\n        for (OrderRequest req : requests) {\n            Customer__c customer = customersByUid.get(req.customerUid);\n            if (customer == null) {\n                throw new ModelNotFoundException('Customer not found for uid: ' + req.customerUid);\n            }\n\n            Decimal total = 0;\n            List<OrderEntry__c> orderEntries = new List<OrderEntry__c>();\n            Integer entryNumber = 1;\n\n            for (OrderLine line : req.lines) {\n                Product__c product = productsByCode.get(line.productCode);\n                if (product == null) {\n                    throw new ModelNotFoundException('Product not found for code: ' + line.productCode);\n                }\n                // Active product check.\n                if (product.Active__c != true) {\n                    throw new OrderValidationException('Product ' + line.productCode + ' is not active.');\n                }\n                // Stock check.\n                Decimal stock = product.StockLevel__c == null ? 0 : product.StockLevel__c;\n                if (stock < line.quantity) {\n                    throw new OrderValidationException('Insufficient stock for product ' + line.productCode + '.');\n                }\n\n                Decimal unitPrice = product.Price__c == null ? 0 : product.Price__c;\n                total += unitPrice * line.quantity;\n\n                OrderEntry__c entry = new OrderEntry__c(\n                    EntryNumber__c = entryNumber,\n                    Product__c = product.Id,\n                    Quantity__c = line.quantity,\n                    UnitPrice__c = unitPrice\n                );\n                orderEntries.add(entry);\n                entryNumber++;\n            }\n\n            // Strictly-positive total rejection.\n            if (total <= 0) {\n                throw new OrderValidationException('Order ' + req.code + ' total must be strictly positive.');\n            }\n\n            Order__c order = new Order__c(\n                Code__c = req.code,\n                Customer__c = customer.Id,\n                Status__c = 'NEW',\n                Paid__c = false,\n                OrderDate__c = System.now(),\n                TotalAmount__c = total\n            );\n            ordersToInsert.add(order);\n            entriesByOrderIndex.put(index, orderEntries);\n            index++;\n        }\n\n        // Bulk insert orders (security enforced).\n        SObjectAccessDecision orderDecision = Security.stripInaccessible(\n            AccessType.CREATABLE, ordersToInsert\n        );\n        List<Order__c> sanitizedOrders = (List<Order__c>) orderDecision.getRecords();\n        insert sanitizedOrders;\n\n        // Wire entry lookups now that order Ids exist, then bulk insert.\n        for (Integer i = 0; i < sanitizedOrders.size(); i++) {\n            List<OrderEntry__c> orderEntries = entriesByOrderIndex.get(i);\n            if (orderEntries != null) {\n                for (OrderEntry__c entry : orderEntries) {\n                    entry.Order__c = sanitizedOrders[i].Id;\n                    entriesToInsert.add(entry);\n                }\n            }\n        }\n\n        if (!entriesToInsert.isEmpty()) {\n            SObjectAccessDecision entryDecision = Security.stripInaccessible(\n                AccessType.CREATABLE, entriesToInsert\n            );\n            insert entryDecision.getRecords();\n        }\n\n        createdOrders.addAll(sanitizedOrders);\n        System.debug('Created ' + createdOrders.size() + ' orders.');\n        return createdOrders;\n    }\n\n    /**\n     * Bulk-safe cancellation. Guards against cancelling orders that are not in\n     * a cancellable status (original cancel-status guard).\n     */\n    public List<Order__c> cancelOrders(Set<String> orderCodes) {\n        List<Order__c> updated = new List<Order__c>();\n        if (orderCodes == null || orderCodes.isEmpty()) {\n            return updated;\n        }\n\n        OrderSelector orderSelector = new OrderSelector();\n        List<Order__c> orders = orderSelector.selectByCodes(orderCodes);\n\n        for (Order__c order : orders) {\n            // Cancel-status guard: cannot cancel already-cancelled or completed orders.\n            if (order.Status__c == 'CANCELLED') {\n                throw new OrderValidationException('Order ' + order.Code__c + ' is already cancelled.');\n            }\n            if (order.Status__c == 'COMPLETED') {\n                throw new OrderValidationException('Order ' + order.Code__c + ' is completed and cannot be cancelled.');\n            }\n            order.Status__c = 'CANCELLED';\n            updated.add(order);\n        }\n\n        if (!updated.isEmpty()) {\n            SObjectAccessDecision decision = Security.stripInaccessible(\n                AccessType.UPDATABLE, updated\n            );\n            update decision.getRecords();\n        }\n        System.debug('Cancelled ' + updated.size() + ' orders.');\n        return updated;\n    }\n\n    /**\n     * Determines which of the supplied orders should be expedited based on the\n     * expedited total threshold.\n     */\n    public List<Order__c> filterExpedited(List<Order__c> orders) {\n        List<Order__c> expedited = new List<Order__c>();\n        if (orders == null) {\n            return expedited;\n        }\n        for (Order__c order : orders) {\n            if (order.TotalAmount__c != null && order.TotalAmount__c > EXPEDITED_THRESHOLD) {\n                expedited.add(order);\n            }\n        }\n        return expedited;\n    }\n}\n\n/**\n * Thin controller exposing order operations to the UI. Delegates all logic to\n * the service layer and converts internal exceptions to AuraHandledException.\n */\npublic with sharing class OrderController {\n\n    @AuraEnabled\n    public static List<Order__c> createOrders(List<OrderService.OrderRequest> requests) {\n        try {\n            return new OrderService().createOrders(requests);\n        } catch (Exception e) {\n            System.debug('createOrders failed: ' + e.getMessage());\n            throw new AuraHandledException(e.getMessage());\n        }\n    }\n\n    @AuraEnabled\n    public static List<Order__c> cancelOrders(List<String> orderCodes) {\n        try {\n            return new OrderService().cancelOrders(new Set<String>(orderCodes));\n        } catch (Exception e) {\n            System.debug('cancelOrders failed: ' + e.getMessage());\n            throw new AuraHandledException(e.getMessage());\n        }\n    }\n}\n\n/**\n * Test coverage for the OrderService and OrderController.\n */\n@isTest\nprivate class OrderServiceTest {\n\n    private static Customer__c makeCustomer(String uid) {\n        Customer__c c = new Customer__c(\n            Uid__c = uid,\n            Name__c = 'Test ' + uid,\n            Email__c = uid + '@example.com'\n        );\n        insert c;\n        return c;\n    }\n\n    private static Product__c makeProduct(String code, Boolean active, Decimal stock, Decimal price) {\n        Product__c p = new Product__c(\n            Code__c = code,\n            Name__c = 'Prod ' + code,\n            Active__c = active,\n            StockLevel__c = stock,\n            Price__c = price\n        );\n        insert p;\n        return p;\n    }\n\n    @isTest\n    static void testCreateOrderSuccess() {\n        makeCustomer('CUST1');\n        makeProduct('P1', true, 100, 25);\n\n        List<OrderService.OrderLine> lines = new List<OrderService.OrderLine>{\n            new OrderService.OrderLine('P1', 4)\n        };\n        List<OrderService.OrderRequest> requests = new List<OrderService.OrderRequest>{\n            new OrderService.OrderRequest('ORD1', 'CUST1', lines)\n        };\n\n        Test.startTest();\n        List<Order__c> created = new OrderService().createOrders(requests);\n        Test.stopTest();\n\n        System.assertEquals(1, created.size(), 'One order should be created.');\n        System.assertEquals('NEW', created[0].Status__c, 'Status should be NEW.');\n        System.assertEquals(false, created[0].Paid__c, 'Order should be unpaid.');\n        System.assertEquals(100, created[0].TotalAmount__c, 'Total should be 4 * 25.');\n    }\n\n    @isTest\n    static void testBlankCodeRejected() {\n        makeCustomer('CUST2');\n        makeProduct('P2', true, 10, 5);\n        List<OrderService.OrderLine> lines = new List<OrderService.OrderLine>{\n            new OrderService.OrderLine('P2', 1)\n        };\n        List<OrderService.OrderRequest> requests = new List<OrderService.OrderRequest>{\n            new OrderService.OrderRequest('', 'CUST2', lines)\n        };\n\n        Boolean thrown = false;\n        try {\n            new OrderService().createOrders(requests);\n        } catch (OrderValidationException e) {\n            thrown = true;\n        }\n        System.assert(thrown, 'Blank code should be rejected.');\n    }\n\n    @isTest\n    static void testCustomerNotFound() {\n        makeProduct('P3', true, 10, 5);\n        List<OrderService.OrderLine> lines = new List<OrderService.OrderLine>{\n            new OrderService.OrderLine('P3', 1)\n        };\n        List<OrderService.OrderRequest> requests = new List<OrderService.OrderRequest>{\n            new OrderService.OrderRequest('ORD3', 'MISSING', lines)\n        };\n\n