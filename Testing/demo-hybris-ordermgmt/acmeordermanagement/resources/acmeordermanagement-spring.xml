<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- ============================================================= -->
    <!-- Data access                                                    -->
    <!-- ============================================================= -->
    <bean id="orderDao" class="com.acme.commerce.order.dao.OrderDao">
        <property name="flexibleSearchService" ref="flexibleSearchService"/>
    </bean>

    <!-- ============================================================= -->
    <!-- Services                                                       -->
    <!-- ============================================================= -->
    <bean id="orderService" class="com.acme.commerce.order.service.DefaultOrderService">
        <property name="orderDao" ref="orderDao"/>
        <property name="modelService" ref="modelService"/>
    </bean>

    <bean id="promotionService" class="com.acme.commerce.order.service.DefaultPromotionService"/>

    <!-- ============================================================= -->
    <!-- Scheduled job: cancel stale unpaid orders every night at 02:00 -->
    <!-- (becomes Scheduled Apex on Salesforce)                         -->
    <!-- ============================================================= -->
    <bean id="orderCleanupJob" class="com.acme.commerce.order.job.OrderCleanupJob"
          parent="abstractJobPerformable">
        <property name="orderDao" ref="orderDao"/>
        <property name="modelService" ref="modelService"/>
    </bean>

    <bean id="orderCleanupCronJob" class="de.hybris.platform.cronjob.model.CronJobModel">
        <property name="code" value="orderCleanupCronJob"/>
        <property name="job" ref="orderCleanupJob"/>
    </bean>

    <!-- Cron expression: second minute hour day month weekday -->
    <!-- 0 0 2 * * ?  ==  every day at 02:00:00 -->
    <bean id="orderCleanupTrigger" class="de.hybris.platform.servicelayer.internal.jalo.ServicelayerJob">
        <property name="cronExpression" value="0 0 2 * * ?"/>
        <property name="cronJob" ref="orderCleanupCronJob"/>
    </bean>

</beans>
