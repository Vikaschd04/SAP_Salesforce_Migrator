{"code":"// ============================================================\n// Custom Exception\n// ============================================================\npublic class OrderServiceException extends Exception {}\n\n// ============================================================\n// CustomerSelector\n// ============================================================\npublic with sharing class CustomerSelector {\n\n    public List<Schema.SObjectField> getSObjectFieldList() {\n        return new List<Schema.SObjectField>{\n            Customer__c.Id,\n            Customer__c.Name__c,\n            Customer__c.Email__c,\n            Customer__c.Uid__c\n        };\n    }\n\n    public Schema.SObjectType getSObjectType() {\n        return Customer__c.SObjectType;\n    }\n\n    public List<Customer__c> selectSObjectsById(Set<Id> ids) {\n        return [\n            SELECT Id, Name__c, Email__c, Uid__c\n            FROM Customer__c\n            WHERE Id IN :ids\n            WITH SECURITY_ENFORCED\n        ];\n    }\n\n    public List<Customer__c> selectByUids(Set<String> uids) {\n        return [\n            SELECT Id, Name__c, Email__c, Uid__c\n            FROM Customer__c\n            WHERE Uid__c IN :uids\n            WITH SECURITY_ENFORCED\n        ];\n    }\n\n    public Customer__c selectByUid(String uid) {\n        List<Customer__c> results = selectByUids(new Set<String>{ uid });\n        return results.isEmpty() ? null : results[0];\n    }\n\n    public List<Customer__c> selectByEmailDomain(String domain) {\n        String pattern = '%@' + domain;\n        return [\n            SELECT Id, Name__c, Email__c, Uid__c\n            FROM Customer__c\n            WHERE Email__c LIKE :pattern\n            WITH SECURITY_ENFORCED\n        ];\n    }\n}\n\n// ============================================================\n// OrderSelector\n// ============================================================\npublic with sharing class OrderSelector {\n\n    public List<Schema.SObjectField> getSObjectFieldList() {\n        return new List<Schema.SObjectField>{\n            Order__c.Id,\n            Order__c.Code__c,\n            Order__c.Customer__c,\n            Order__c.Status__c,\n            Order__c.TotalAmount__c\n        };\n    }\n\n    public Schema.SObjectType getSObjectType() {\n        return Order__c.SObjectType;\n    }\n\n    public List<Order__c> selectSObjectsById(Set<Id> ids) {\n        return [\n            SELECT Id, Code__c, Customer__c, Status__c, TotalAmount__c\n            FROM Order__c\n            WHERE Id IN :ids\n            WITH SECURITY_ENFORCED\n        ];\n    }\n\n    public List<Order__c> selectByCodes(Set<String> codes) {\n        return [\n            SELECT Id, Code__c, Customer__c, Status__c, TotalAmount__c\n            FROM Order__c\n            WHERE Code__c IN :codes\n            WITH SECURITY_ENFORCED\n        ];\n    }\n}\n\n// ============================================================\n// OrderService\n// ============================================================\npublic with sharing class OrderService {\n\n    private final OrderSelector orderSelector;\n    private final CustomerSelector customerSelector;\n\n    // Default constructor\n    public OrderService() {\n        this(new OrderSelector(), new CustomerSelector());\n    }\n\n    // Constructor injection (translated from Spring @Autowired)\n    public OrderService(OrderSelector orderSelector, CustomerSelector customerSelector) {\n        this.orderSelector = orderSelector;\n        this.customerSelector = customerSelector;\n    }\n\n    /**\n     * Bulkified retrieval of orders by Id.\n     */\n    public List<Order__c> getOrder(Set<Id> orderIds) {\n        System.debug('getOrder called with ids: ' + orderIds);\n        if (orderIds == null || orderIds.isEmpty()) {\n            return new List<Order__c>();\n        }\n        return orderSelector.selectSObjectsById(orderIds);\n    }\n\n    /**\n     * Business rule: priority > 5 means the order is expedited.\n     * Bulkified: accepts a map of key -> priority and returns key -> isExpedited.\n     */\n    public Map<String, Boolean> isExpedited(Map<String, Integer> priorityByKey) {\n        Map<String, Boolean> results = new Map<String, Boolean>();\n        if (priorityByKey == null || priorityByKey.isEmpty()) {\n            return results;\n        }\n        for (String key : priorityByKey.keySet()) {\n            Integer priority = priorityByKey.get(key);\n            results.put(key, priority != null && priority > 5);\n        }\n        return results;\n    }\n\n    /**\n     * Bulkified order placement.\n     * Business rules enforced:\n     *  - order total must be > 0\n     *  - referenced customer must exist\n     */\n    public List<Order__c> placeOrder(List<Order__c> orders) {\n        System.debug('placeOrder called with ' + (orders == null ? 0 : orders.size()) + ' orders');\n        if (orders == null || orders.isEmpty()) {\n            return new List<Order__c>();\n        }\n\n        // Collect customer ids for a single, set-based lookup (no SOQL in loop).\n        Set<Id> customerIds = new Set<Id>();\n        for (Order__c ord : orders) {\n            if (ord.Customer__c == null) {\n                throw new OrderServiceException('Order must reference a customer.');\n            }\n            if (ord.TotalAmount__c == null || ord.TotalAmount__c <= 0) {\n                throw new OrderServiceException('Order total must be greater than 0.');\n            }\n            customerIds.add(ord.Customer__c);\n        }\n\n        // Single bulk query for all referenced customers.\n        Map<Id, Customer__c> existingCustomers = new Map<Id, Customer__c>();\n        for (Customer__c cust : customerSelector.selectSObjectsById(customerIds)) {\n            existingCustomers.put(cust.Id, cust);\n        }\n\n        for (Order__c ord : orders) {\n            if (!existingCustomers.containsKey(ord.Customer__c)) {\n                throw new OrderServiceException('Customer does not exist: ' + ord.Customer__c);\n            }\n        }\n\n        // Enforce FLS/CRUD on write.\n        SObjectAccessDecision decision = Security.stripInaccessible(AccessType.CREATABLE, orders);\n        List<Order__c> sanitized = (List<Order__c>) decision.getRecords();\n        insert sanitized;\n        return sanitized;\n    }\n}\n\n// ============================================================\n// OrderController\n// ============================================================\npublic with sharing class OrderController {\n\n    private final OrderService orderService;\n\n    public OrderController() {\n        this.orderService = new OrderService();\n    }\n\n    public OrderController(OrderService orderService) {\n        this.orderService = orderService;\n    }\n\n    @AuraEnabled(cacheable=true)\n    public static List<Order__c> getOrders(List<Id> orderIds) {\n        try {\n            OrderService service = new OrderService();\n            return service.getOrder(new Set<Id>(orderIds));\n        } catch (Exception e) {\n            System.debug('getOrders error: ' + e.getMessage());\n            throw new AuraHandledException(e.getMessage());\n        }\n    }\n\n    @AuraEnabled\n    public static List<Order__c> placeOrders(List<Order__c> orders) {\n        try {\n            OrderService service = new OrderService();\n            return service.placeOrder(orders);\n        } catch (Exception e) {\n            System.debug('placeOrders error: ' + e.getMessage());\n            throw new AuraHandledException(e.getMessage());\n        }\n    }\n}\n\n// ============================================================\n// Test: OrderService\n// ============================================================\n@isTest\nprivate class OrderServiceTest {\n\n    @isTest\n    static void testGetOrder() {\n        Customer__c cust = new Customer__c(Name__c = 'Test', Uid__c = 'u1', Email__c = 'a@b.com');\n        insert cust;\n        Order__c ord = new Order__c(Code__c = 'O1', Customer__c = cust.Id, TotalAmount__c = 100, Status__c = 'New');\n        insert ord;\n\n        Test.startTest();\n        OrderService service = new OrderService();\n        List<Order__c> results = service.getOrder(new Set<Id>{ ord.Id });\n        Test.stopTest();\n\n        System.System.System.assertEquals(1, results.size(), 'Should return the inserted order');\n        System.System.System.assertEquals(ord.Id, results[0].Id, 'Should match the order id');\n    }\n\n    @isTest\n    static void testGetOrderEmpty() {\n        OrderService service = new OrderService();\n        List<Order__c> results = service.getOrder(new Set<Id>());\n        System.System.System.assertEquals(0, results.size(), 'Empty input returns empty list');\n    }\n\n    @isTest\n    static void testIsExpedited() {\n        OrderService service = new OrderService();\n        Map<String, Integer> input = new Map<String, Integer>{\n            'high' => 6,\n            'low' => 3,\n            'boundary' => 5\n        };\n        Map<String, Boolean> results = service.isExpedited(input);\n        System.System.System.assertEquals(true, results.get('high'), 'Priority 6 should be expedited');\n        System.System.System.assertEquals(false, results.get('low'), 'Priority 3 should not be expedited');\n        System.System.System.assertEquals(false, results.get('boundary'), 'Priority 5 should not be expedited');\n    }\n\n    @isTest\n    static void testPlaceOrderSuccess() {\n        Customer__c cust = new Customer__c(Name__c = 'Test', Uid__c = 'u2', Email__c = 'c@d.com');\n        insert cust;\n        List<Order__c> orders = new List<Order__c>{\n            new Order__c(Code__c = 'O2', Customer__c = cust.Id, TotalAmount__c = 50, Status__c = 'New')\n        };\n\n        Test.startTest();\n        OrderService service = new OrderService();\n