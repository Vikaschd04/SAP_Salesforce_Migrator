{"test_class":"@isTest\nprivate class CustomerSelectorTest {\n\n    @testSetup\n    static void setupData() {\n        List<Customer__c> customers = new List<Customer__c>();\n        customers.add(new Customer__c(Name__c = 'Alice', Uid__c = 'alice001', Email__c = 'alice@example.com'));\n        customers.add(new Customer__c(Name__c = 'Bob', Uid__c = 'bob002', Email__c = 'bob@example.com'));\n        insert customers;\n    }\n\n    @isTest\n    static void testSelectSObjectsById() {\n        List<Customer__c> existing = [SELECT Id FROM Customer__c];\n        Set<Id> ids = new Set<Id>();\n        for (Customer__c c : existing) {\n            ids.add(c.Id);\n        }\n\n        Test.startTest();\n        List<Customer__c> results = new CustomerSelector().selectSObjectsById(ids);\n        Test.stopTest();\n\n        System.System.assertEquals(existing.size(), results.size(), 'Should return all customers by Id');\n    }\n\n    @isTest\n    static void testSelectByUids() {\n        Set<String> uids = new Set<String>{ 'alice001', 'bob002' };\n\n        Test.startTest();\n        List<Customer__c> results = new CustomerSelector().selectByUids(uids);\n        Test.stopTest();\n\n        System.System.assertEquals(2, results.size(), 'Should return two customers by uids');\n    }\n\n    @isTest\n    static void testSelectByUid() {\n        Test.startTest();\n        Customer__c result = new CustomerSelector().selectByUid('alice001');\n        Test.stopTest();\n\n        System.System.assertNotEquals(null, result, 'Customer should not be null');\n        System.System.assertEquals('alice001', result.Uid__c, 'Uid should match');\n    }\n\n    @isTest\n    static void testSelectByEmailDomain() {\n        Test.startTest();\n        List<Customer__c> results = new CustomerSelector().selectByEmailDomain('example.com');\n        Test.stopTest();\n\n        System.assert(results.size() >= 0, 'Should return customers by email domain');\n    }\n\n    @isTest\n    static void testGetSObjectType() {\n        Schema.SObjectType t = new CustomerSelector().getSObjectType();\n        System.System.assertEquals(Customer__c.SObjectType, t, 'SObjectType should be Customer__c');\n    }\n\n    @isTest\n    static void testGetSObjectFieldList() {\n        List<Schema.SObjectField> fields = new CustomerSelector().getSObjectFieldList();\n        System.System.assertNotEquals(null, fields, 'Field list should not be null');\n    }\n\n    // ============================================================\n    // Business rule: An order total must be greater than zero\n    // ============================================================\n    @isTest\n    static void testOrderTotalPositiveIsAccepted() {\n        Customer__c cust = new Customer__c(Name__c = 'Carol', Uid__c = 'carol003', Email__c = 'carol@example.com');\n        insert cust;\n\n        List<Order__c> orders = new List<Order__c>{\n            new Order__c(Code__c = 'POS-1', Customer__c = cust.Id, TotalAmount__c = 100, Status__c = 'New')\n        };\n\n        Test.startTest();\n        List<Order__c> results = new OrderService().placeOrder(orders);\n        Test.stopTest();\n\n        System.System.assertEquals(1, results.size(), 'Order with positive total should be placed');\n        System.assert(results[0].TotalAmount__c > 0, 'Persisted order total must be greater than zero');\n    }\n\n    @isTest\n    static void testOrderTotalZeroIsRejected() {\n        Customer__c cust = new Customer__c(Name__c = 'Dan', Uid__c = 'dan004', Email__c = 'dan@example.com');\n        insert cust;\n\n        List<Order__c> orders = new List<Order__c>{\n            new Order__c(Code__c = 'ZERO-1', Customer__c = cust.Id, TotalAmount__c = 0, Status__c = 'New')\n        };\n\n        Boolean threw = false;\n        String message;\n        Test.startTest();\n        try {\n            new OrderService().placeOrder(orders);\n        } catch (OrderServiceException e) {\n            threw = true;\n            message = e.getMessage();\n        }\n        Test.stopTest();\n\n        System.System.assertEquals(true, threw, 'An order total of zero must be rejected');\n        System.System.assertEquals('Order total must be greater than 0.', message, 'Should report the total rule violation');\n        System.System.assertEquals(0, [SELECT COUNT() FROM Order__c WHERE Code__c = 'ZERO-1'], 'No order should be persisted');\n    }\n\n    @isTest\n    static void testOrderTotalNegativeIsRejected() {\n        Customer__c cust = new Customer__c(Name__c = 'Eve', Uid__c = 'eve005', Email__c = 'eve@example.com');\n        insert cust;\n\n        List<Order__c> orders = new List<Order__c>{\n            new Order__c(Code__c = 'NEG-1', Customer__c = cust.Id, TotalAmount__c = -25, Status__c = 'New')\n        };\n\n        Boolean threw = false;\n        Test.startTest();\n        try {\n            new OrderService().placeOrder(orders);\n        } catch (OrderServiceException e) {\n            threw = true;\n        }\n        Test.stopTest();\n\n        System.System.assertEquals(true, threw, 'A negative order total must be rejected');\n    }\n\n    // ============================================================\n    // Business rule: Orders with priority greater than 5 are expedited\n    // ============================================================\n    @isTest\n    static void testPriorityGreaterThanFiveIsExpedited() {\n        OrderService service = new OrderService();\n        Map<String, Integer> input = new Map<String, Integer>{\n            'urgent'   => 9,\n            'aboveFive'=> 6,\n            'boundary' => 5,\n            'low'      => 1,\n            'nullPrio' => null\n        };\n\n        Test.startTest();\n        Map<String, Boolean> results = service.isExpedited(input);\n        Test.stopTest();\n\n        System.System.assertEquals(true, results.get('urgent'), 'Priority 9 should be expedited');\n        System.System.assertEquals(true, results.get('aboveFive'), 'Priority 6 should be expedited');\n        System.System.assertEquals(false, results.get('boundary'), 'Priority exactly 5 should NOT be expedited');\n        System.System.assertEquals(false, results.get('low'), 'Priority 1 should NOT be expedited');\n        System.System.assertEquals(false, results.get('nullPrio'), 'Null priority should NOT be expedited');\n    }\n\n    // ============================================================\n    // Business rule: A customer must exist before an order can be placed\n    // ============================================================\n    @isTest\n    static void testExistingCustomerAllowsOrder() {\n        Customer__c cust = new Customer__c(Name__c = 'Frank', Uid__c = 'frank006', Email__c = 'frank@example.com');\n        insert cust;\n\n        List<Order__c> orders = new List<Order__c>{\n            new Order__c(Code__c = 'CUST-OK', Customer__c = cust.Id, TotalAmount__c = 75, Status__c = 'New')\n        };\n\n        Test.startTest();\n        List<Order__c> results = new OrderService().placeOrder(orders);\n        Test.stopTest();\n\n        System.System.assertEquals(1, results.size(), 'Order for an existing customer should be placed');\n        System.System.assertEquals(cust.Id, results[0].Customer__c, 'Order should reference the existing customer');\n    }\n\n    @isTest\n    static void testMissingCustomerReferenceIsRejected() {\n        List<Order__c> orders = new List<Order__c>{\n            new Order__c(Code__c = 'NO-CUST', Customer__c = null, TotalAmount__c = 50, Status__c = 'New')\n        };\n\n        Boolean threw = false;\n        String message;\n        Test.startTest();\n        try {\n            new OrderService().placeOrder(orders);\n        } catch (OrderServiceException e) {\n            threw = true;\n            message = e.getMessage();\n        }\n        Test.stopTest();\n\n        System.System.assertEquals(true, threw, 'An order without a customer reference must be rejected');\n        System.System.assertEquals('Order must reference a customer.', message, 'Should report the missing customer reference');\n    }\n\n    @isTest\n    static void testNonExistentCustomerIsRejected() {\n        // Create then delete a customer to obtain a valid-but-nonexistent Id.\n        Customer__c cust = new Customer__c(Name__c = 'Ghost', Uid__c = 'ghost007', Email__c = 'ghost@example.com');\n        insert cust;\n        Id ghostId = cust.Id;\n        delete cust;\n\n        List<Order__c> orders = new List<Order__c>{\n            new Order__c(Code__c = 'GHOST-1', Customer__c = ghostId, TotalAmount__c = 60, Status__c = 'New')\n        };\n\n        Boolean threw = false;\n        String message;\n        Test.startTest();\n        try {\n            new OrderService().placeOrder(orders);\n        } catch (OrderServiceException e) {\n            threw = true;\n            message = e.getMessage();\n        }\n        Test.stopTest();\n\