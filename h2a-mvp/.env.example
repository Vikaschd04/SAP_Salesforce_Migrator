# Pick a provider in config.yaml (or via H2A_PROVIDER) and set the matching key.

# provider: anthropic  — best quality. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: route the anthropic provider through an Anthropic-compatible gateway
# (self-hosted proxy, LiteLLM, corporate gateway, a dev proxy, ...). Leave unset
# to use api.anthropic.com directly. WARNING: a third-party gateway sees every
# prompt and source file you send, and may override the model or inject its own
# context — only point this at an endpoint you trust. Do not use for sensitive code.
# ANTHROPIC_BASE_URL=https://your-anthropic-compatible-gateway

# provider: openrouter — free/cheap models for dev/testing. https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# provider: mock — no key needed (deterministic keyless dry run):
#   H2A_PROVIDER=mock python -m src.main repo-migrate --input <dir> --output <dir>
